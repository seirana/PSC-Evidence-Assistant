{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PSC Demo with Llama 3.2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_demo.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "LLM_MODE": "ollama",
                "OLLAMA_MODEL": "llama3.2:3b",
                "LLM_HTTP_TIMEOUT": "600",
                "LLM_TEMPERATURE": "0.0"
            }
        }
    ]
}
